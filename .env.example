# Local Ollama server and default generation model
# Change OLLAMA_MODEL to any installed model (see: ollama list).
# CLI --model overrides this value for scripts that expose it.
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=gemma4:latest

# Separate model for embeddings / semantic memory / RAG
EMBEDDING_MODEL=embeddinggemma:300m-qat-q4_0

# Local memory files (not used automatically by voice chats)
MEMORY_JSONL_PATH=data/memory/memory.jsonl
VECTOR_DB_PATH=data/memory/vectors.sqlite

# Microphone / GUI voice chat
AUDIO_SOURCE=default
AUDIO_SAMPLE_RATE=16000

# Spoken response (GUI)
TTS_SPEED=1.2
TTS_LANG=es
